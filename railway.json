{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build --workspace=apps/backend"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=apps/backend",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
