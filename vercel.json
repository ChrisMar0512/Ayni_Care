{
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{node_modules,apps/backend/node_modules}/.prisma/client/**"
    }
  },
  "crons": [
    {
      "path": "/api/jobs/reminders",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/api"
    },
    {
      "source": "/admin/insights",
      "destination": "/api"
    },
    {
      "source": "/admin/export-csv",
      "destination": "/api"
    },
    {
      "source": "/admin/:match*",
      "destination": "/api"
    },
    {
      "source": "/privacy-policy",
      "destination": "/api"
    },
    {
      "source": "/politica-de-privacidad",
      "destination": "/api"
    },
    {
      "source": "/terminos",
      "destination": "/api"
    },
    {
      "source": "/delete-account",
      "destination": "/api"
    },
    {
      "source": "/api/:match*",
      "destination": "/api"
    }
  ]
}
