{
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{node_modules,apps/backend/node_modules}/.prisma/client/**"
    }
  },
  "crons": [
    {
      "path": "/api/jobs/reminders",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/admin/:match*",
      "destination": "/api"
    },
    {
      "source": "/api/:match*",
      "destination": "/api"
    }
  ]
}
