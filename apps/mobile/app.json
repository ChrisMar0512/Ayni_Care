{
  "expo": {
    "name": "Ayni Care",
    "slug": "ayni-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "aynicare",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aynicare.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ayni Care necesita acceso a tu micrófono para que puedas registrar actividades de cuidado, medicamentos y notas usando tu voz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aynicare.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ecace12d-4812-4bfb-a4c1-4ee5cfda5269"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-audio"
    ]
  }
}
