DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
RESEND_API_KEY=re_...
FROM_EMAIL=hola@aynicare.com
JWT_SECRET=cambia_esto_por_un_secreto_seguro
PORT=3000
NODE_ENV=development

# ── META WHATSAPP CLOUD API (OFICIAL) ───────────────────────────
META_WA_PHONE_NUMBER_ID=your_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_access_token
META_WA_VERIFY_TOKEN=ayni_care_meta_webhook_secret_2026

# ── YUYAY (TELEASISTENCIA POR VOZ) ──────────────────────────────
# Token para endpoints internos: Authorization: Bearer <YUYAY_ADMIN_TOKEN>
YUYAY_ADMIN_TOKEN=genera_un_token_largo_y_aleatorio
# Secreto del cron externo: Authorization: Bearer <YUYAY_CRON_SECRET> (Vercel usa CRON_SECRET)
YUYAY_CRON_SECRET=genera_otro_token_largo
# Debe coincidir con el "Server URL Secret" del asistente en Vapi (cabecera x-vapi-secret)
VAPI_WEBHOOK_SECRET=genera_otro_token_largo
# vapi | simulation (en producción la simulación está bloqueada)
YUYAY_VOICE_PROVIDER=vapi
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
# Poner en false si se usa solo un cron externo (evita reportes duplicados)
YUYAY_SCHEDULER_ENABLED=true
